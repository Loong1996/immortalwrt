/dts-v1/;

/* BL2 and TF-A reserve the first 2 MiB of DRAM. */
/memreserve/ 0x80000000 0x200000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "en7581.dtsi"

/*
 * Same board peripherals as the Nokia XG-040G-MD, minus USB.  The LEDs are
 * blue where the Nokia ones are green; the red one stays red.
 */

/ {
	model = "ZNXT ZN504XG-D";
	compatible = "znxt,zn504xg-d", "airoha,an7581", "airoha,en7581";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	options {
		u-boot {
			compatible = "u-boot,config";
			/* Web recovery LED chase, in this order; red stays out. */
			httpd-chase-leds = <&led_power &led_wan &led_wan_online>;
		};
	};

	/* 512 MiB fallback; dram_init() probes and fixups the real size. */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: led-power {
			label = "blue:power";
			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
		};

		led_wan: led-wan {
			label = "blue:wan";
			gpios = <&en7581_pinctrl 18 GPIO_ACTIVE_LOW>;
		};

		led-wan-red {
			label = "red:wan";
			gpios = <&en7581_pinctrl 19 GPIO_ACTIVE_LOW>;
		};

		led_wan_online: led-wan-online {
			label = "blue:wan-online";
			gpios = <&en7581_pinctrl 20 GPIO_ACTIVE_LOW>;
		};
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 50>;
};

&snfi {
	status = "okay";
};

&spi_nand {
	/* ID 2c:24 covers multiple geometries; the board compatible selects F50L2G41XA. */
	compatible = "esmt,f50l2g41xa", "spi-nand";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bl2";
			reg = <0x0 0x20000>;
		};

		partition@20000 {
			label = "ubi";
			reg = <0x20000 0xffe0000>;
		};
	};
};

&i2c0 {
	status = "okay";
};

&eth {
	status = "okay";
};
