/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "en7581.dtsi"

/ {
	model = "Nokia XG-040G-TF";
	compatible = "nokia,xg-040g-tf",
		     "airoha,an7581",
		     "airoha,en7581";

	chosen {
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
		linux,usable-memory-range = <0x0 0x80200000 0x0 0x1fe00000>;
	};

	options {
		u-boot {
			compatible = "u-boot,config";
			/* Web recovery LED chase, in this order; red stays out. */
			httpd-chase-leds = <&led_power &led_wan &led_wan_online &led_usb1 &led_usb2>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	keys {
		compatible = "gpio-keys";

		button-0 {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: led-0 {
			label = "blue:power";
			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
		};

		led_wan: led-1 {
			label = "blue:wan";
			gpios = <&en7581_pinctrl 18 GPIO_ACTIVE_LOW>;
		};

		led-2 {
			label = "red:wan";
			gpios = <&en7581_pinctrl 19 GPIO_ACTIVE_LOW>;
		};

		led_wan_online: led-3 {
			label = "blue:wan-online";
			gpios = <&en7581_pinctrl 20 GPIO_ACTIVE_LOW>;
		};

		led_usb2: led-4 {
			label = "blue:usb-2";
			gpios = <&en7581_pinctrl 34 GPIO_ACTIVE_LOW>;
		};

		led_usb1: led-5 {
			label = "blue:usb-1";
			gpios = <&en7581_pinctrl 35 GPIO_ACTIVE_LOW>;
		};
	};
};

&snfi {
	status = "okay";
};

&spi_nand {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bl2";
			reg = <0x0 0x20000>;
		};

		partition@20000 {
			label = "ubi";
			reg = <0x20000 0xffe0000>;
		};
	};
};

&i2c0 {
	status = "okay";
};

&eth {
	status = "okay";
};
