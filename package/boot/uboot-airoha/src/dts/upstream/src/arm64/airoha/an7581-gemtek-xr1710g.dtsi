// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
/*
 * Brightspeed / Gemtek XR1710G, whichever way it is started (the .dts files
 * say which, and lay out the flash to match).
 *
 * Only the two gigabit ports (LAN3 / LAN4, on the internal switch) come up
 * here.  The two 10G ports hang off RTL8261 PHYs behind the PCS, which this
 * U-Boot does not drive; recovery is done over a gigabit port.
 */

/* The vendor bootloader's ATF lives here; so does ours (BL31 at 0x80002000). */
/memreserve/ 0x80000000 0x200000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "en7581.dtsi"

/ {
	compatible = "gemtek,xr1710g-ubi", "airoha,an7581", "airoha,en7581";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	options {
		u-boot {
			compatible = "u-boot,config";
			/*
			 * The front has one status LED in four colours, so the
			 * chase runs through the colours.
			 */
			httpd-chase-leds = <&led_status_red &led_status_green
					    &led_status_blue &led_status_white>;
		};
	};

	/* 512 MiB fallback; dram_init() probes the real size (2 GiB). */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_status_green: led-status-green {
			label = "green:status";
			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
		};

		led_status_blue: led-status-blue {
			label = "blue:status";
			gpios = <&en7581_pinctrl 19 GPIO_ACTIVE_LOW>;
		};

		led_status_white: led-status-white {
			label = "white:status";
			gpios = <&en7581_pinctrl 20 GPIO_ACTIVE_LOW>;
		};

		led_status_red: led-status-red {
			label = "red:status";
			gpios = <&en7581_pinctrl 29 GPIO_ACTIVE_LOW>;
		};
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 47>;
};

&snfi {
	status = "okay";
};

&snfi {
	status = "okay";
};

&i2c0 {
	status = "okay";
};

&eth {
	status = "okay";
};
