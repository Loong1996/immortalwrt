bootmenu_5=Rebuild the factory volume from the vendor DSD=run web_uboot_dsd_sync ; run bootmenu_confirm_return
ethaddr_factory=gemtek_dsd ethaddr
web_uboot_dsd_sync=gemtek_dsd sync || echo "Factory volume not rebuilt from the vendor DSD, see above"
web_uboot_luci_trigger=if env exists recovery_trigger && test "$recovery_trigger" != 0 ; then echo "recovery_trigger is set: web recovery, once" ; setenv recovery_trigger ; saveenv ; httpd ; fi
web_uboot_boot_hook=run web_uboot_luci_trigger ; run web_uboot_dsd_sync
web_uboot_format_ubi=ubi detach ; mtd erase ubi && ubi part ubi && run web_uboot_dsd_sync
web_uboot_foreign_env=reset
_init_env=setenv _init_env ; run ubi_create_env ; saveenv ; saveenv
_firstboot=setenv _firstboot ; run check_buttons ; ubi part ubi || run web_uboot_no_ubi ; run ethaddr_factory ; run web_uboot_dsd_sync ; run _switch_to_menu ; run _init_env ; run boot_first
