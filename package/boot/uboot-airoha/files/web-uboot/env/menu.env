web_uboot_envver=11
bootmenu_confirm_return=askenv - Press ENTER to return to menu ; bootmenu 60
bootmenu_title=      [1;39mAiroha Web U-Boot @WEB_VERSION@[0m
bootmenu_8=[31mStart web recovery server[0m=httpd ; run bootmenu_confirm_return
bootmenu_9=About - github.com/Loong1996/ImmortalWrt-Airoha=run web_uboot_show_about ; run bootmenu_confirm_return
web_uboot_boot_forever=while true ; do httpd ; sleep 1 ; done
check_buttons=if button reset ; then httpd ; fi
web_uboot_show_about=echo ; echo Airoha Web U-Boot @WEB_VERSION@ by Loong ; echo Guide: https://loong1996.github.io/ImmortalWrt-Airoha/recovery-guide.html ; echo Project: https://github.com/Loong1996/ImmortalWrt-Airoha ; echo Author: https://github.com/Loong1996 ; echo
