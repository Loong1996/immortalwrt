_init_env=setenv _init_env ; run ubi_create_env ; saveenv ; saveenv ; if env exists ubi_create_board_data ; then run ubi_create_board_data ; fi
_firstboot=setenv _firstboot ; run check_buttons ; if ramboot ; then run web_uboot_ramboot ; run web_uboot_boot_forever ; elif ubi part ubi ; then if ubi check fip ; then run web_uboot_env_check ; if env exists _envbad ; then setenv _envbad ; run web_uboot_env_unreadable ; else run _switch_to_menu ; run _init_env ; run boot_first ; fi ; else run web_uboot_foreign_ubi ; fi ; else run web_uboot_no_ubi ; fi
web_uboot_foreign_ubi=echo ; echo "This UBI has no fip volume, so it is not ours (stock firmware?). Leaving it alone." ; echo "Back it up, then flash BL2 + U-Boot with rebuild UBI. Web recovery starts in 3s at http://$ipaddr - press a key for the menu" ; setenv bootmenu_0 "Continue to web recovery at http://$ipaddr=run web_uboot_boot_forever" ; bootmenu 3 ; run web_uboot_boot_forever
