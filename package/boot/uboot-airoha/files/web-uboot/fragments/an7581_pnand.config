# Parallel NAND on top of an7581_web_defconfig, pulled in by a board's
# extra_defconfig=.  These lines land after the #include, so they win.
# assemble.py drops every line starting with '#', so a symbol is turned
# off here with CONFIG_FOO=n, never "# CONFIG_FOO is not set".
# Partitions come from nand@0/partitions in the DTS, as on the SPI NAND
# boards, so no mtdids/mtdparts are set.
CONFIG_MTD_RAW_NAND=y
CONFIG_NAND_AIROHA_EN7581=y
CONFIG_SYS_NAND_ONFI_DETECTION=y
# Nothing on these boards hangs off the SPI controller: the SNFI shares the
# NFI block with the parallel NAND controller and stays disabled, and there
# is no EN8811.  Leaving them out keeps U-Boot under what BL2 will unpack
# (see BL33_LZMA_MAX in the Makefile), about 90 KiB less.
CONFIG_MTD_SPI_NAND=n
CONFIG_SPI_FLASH=n
CONFIG_SPI_FLASH_MTD=n
CONFIG_SPI=n
CONFIG_DM_SPI=n
CONFIG_AIROHA_SNFI_SPI=n
CONFIG_PHY_AIROHA_EN8811=n
