+/* Going back to stock.  Mutually exclusive with the three fields above. */
+#define FIELD_STOCK		"stock"		/* whole-chip all_flash.bin */
+#define FIELD_PARTFILE		"partfile"	/* one factory partition */
+#define FIELD_PARTNAME		"partname"	/* which one it is */
+
+/*
+ * The factory partition map.  This is emphatically not the map this U-Boot
+ * runs on -- ours is bl2 + ubi and nothing else -- but a partition map does
+ * not live on the flash at all: it comes from the device tree, and the device
+ * tree arrives with the bootloader and the kernel.  "mtd write" on the raw
+ * device works in byte offsets and never consults a partition name, so
+ * putting the factory bytes back at the factory offsets brings the factory
+ * map back along with them.
+ *
+ * kernel_slave and rootfs_slave are deliberately missing: their sizes are the
+ * length of the images that were registered, not erase-block multiples, so
+ * neither can be erased on its own.  nsb_slave spans both and is the unit to
+ * use.  nsb_master is absent for a different reason -- it is not a partition
+ * but a second window onto kernel+rootfs, and writing it would write those
+ * twice.
+ */
+struct stock_part {
+	const char	*name;
+	u32		off;
+	u32		size;
+};
+
+static const struct stock_part stock_map[] = {
+	{ "bootloader",	0x0000000, 0x0080000 },
+	{ "romfile",	0x0080000, 0x0040000 },
+	{ "kernel",	0x00c0000, 0x0480000 },
+	{ "rootfs",	0x0540000, 0x2400000 },
+	{ "nsb_slave",	0x2940000, 0x2880000 },
+	{ "bosa",	0x51c0000, 0x0040000 },
+	{ "ri",		0x5200000, 0x0040000 },
+	{ "flag",	0x5240000, 0x0040000 },
+	{ "flagback",	0x5280000, 0x0040000 },
+	{ "config",	0x52c0000, 0x0a00000 },
+	{ "data",	0x5cc0000, 0x80e0000 },
+	{ "oopsfs",	0xdda0000, 0x0400000 },
+	{ "log",	0xe1a0000, 0x0a00000 },
+};
+
+/* all_flash: everything the factory map covers, 235.625 MiB. */
+#define STOCK_TOTAL		0xeba0000
+
+/*
+ * The raw device rather than one of our partitions: bl2 stops at 0x20000 and
+ * ubi starts there, so neither can reach offset 0 with a factory-sized write.
+ */
+#define STOCK_MTD		"spi-nand0"
+
