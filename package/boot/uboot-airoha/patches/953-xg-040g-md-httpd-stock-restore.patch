+/*
+ * Going back to stock.  Mutually exclusive with the three fields above.
+ *
+ * Two operations live under this heading and they are NOT the same thing at
+ * two sizes.  They differ in what they touch, and -- what matters when a
+ * second board shows up -- in how far they carry:
+ *
+ *   factory identity volumes (ri / bosa)      board-independent
+ *       Written as UBI volumes.  Every an758x board that creates them in
+ *       ubi_create_board_data has the same two volumes at the same size:
+ *       XG-040G-MF's defenv carries that line verbatim
+ *       ("ubi create bosa 0x40000 ... ubi create ri 0x40000"), and differs
+ *       from this board's defenv only in four file names.  This half needs
+ *       no per-board constants and carries over unchanged.
+ *
+ *   whole-chip restore (all_flash.bin)        XG-040G-MD only
+ *       Writes factory bytes to raw offsets on the bare flash device.  Its
+ *       constants are measured from THIS model's stock image.  Another
+ *       model's factory layout is a different length at different offsets,
+ *       so reusing these numbers there erases the wrong range and leaves
+ *       nothing bootable -- and this is the one feature whose whole purpose
+ *       is to be used when the machine is already broken.  Supporting
+ *       another board means dumping its stock flash first, never copying
+ *       the constants below.
+ */
+#define FIELD_STOCK		"stock"		/* whole-chip all_flash.bin */
+
+/*
+ * One field per volume rather than a "which one" selector plus a single file
+ * box: the two volumes are independent, a unit that lost both has no reason
+ * to restore them in two passes, and naming the field after the volume drops
+ * the whole class of "picked a file but not a name" mistakes -- the file
+ * cannot arrive without saying what it is.
+ */
+#define FIELD_VOL_RI		"vol_ri"
+#define FIELD_VOL_BOSA		"vol_bosa"
+
+/*
+ * ---- board-independent ---------------------------------------------------
+ *
+ * Per-unit factory data that the ubi layout keeps as UBI volumes.
+ *
+ * These are NOT the stock mtd partitions of the same name.  Stock keeps ri at
+ * a fixed offset of 0x5200000, which on this layout is 80 MiB deep inside the
+ * ubi partition (0x20000..0x10000000) -- writing raw bytes there would tear
+ * through UBI's erase-counter and volume-id headers and destroy the whole
+ * volume table, and it would not even work: ethaddr_factory does "ubi read
+ * ... ri", so it reads the volume, never the offset.
+ *
+ * Same contents and same length as the stock partition (the MAC still sits at
+ * +0x3e), different container.  So this restores them as volumes.
+ */
+struct stock_vol {
+	const char	*name;		/* UBI volume name */
+	const char	*field;		/* form field that carries it */
+	u32		size;
+};
+
+static const struct stock_vol stock_vols[] = {
+	{ "ri",		FIELD_VOL_RI,	0x40000 },	/* factory MAC at +0x3e */
+	{ "bosa",	FIELD_VOL_BOSA,	0x40000 },	/* optics calibration */
+};
+
+/*
+ * ---- XG-040G-MD only -----------------------------------------------------
+ *
+ * Both constants below are this model's stock geometry.  See the note above
+ * FIELD_STOCK before reusing them on another board.
+ */
+
+/* all_flash: everything the factory map covers, 235.625 MiB. */
+#define STOCK_TOTAL		0xeba0000
+
+/*
+ * Whole-chip restore goes to the raw device rather than one of our
+ * partitions: bl2 ends at 0x20000 and ubi begins there, so neither can reach
+ * offset 0 with a factory-sized write.  It is only safe because going back to
+ * stock discards this layout wholesale -- UBI is meant to be gone afterwards.
+ */
+#define STOCK_MTD		"spi-nand0"
+
 /* Version of the recovery page itself, shown next to the heading. */
