 static ulong up_base;
 
+/*
+ * The upload lands at $loadaddr and is flashed from where it landed, so the
+ * ceiling is however much DRAM sits above that.  A factory all_flash.bin is
+ * 235.6 MiB, which on a 512 MiB board leaves around 20 MiB of headroom -- it
+ * fits, but only just, and a fixed limit would either forbid it outright or
+ * let a larger file run off the end of RAM.  Work it out instead.
+ */
+#define UPLOAD_MARGIN	(2 << 20)
+
+static ulong upload_max(void)
+{
+	ulong top = gd->ram_base + gd->ram_size;
+
+	if (up_base + UPLOAD_MARGIN >= top)
+		return 0;
+
+	return top - up_base - UPLOAD_MARGIN;
+}
+
+
 /* Refuse anything that would not plausibly fit in RAM above $loadaddr. */
-#define UPLOAD_MAX	(96 << 20)
 
 /*
  * Panel feedback.  Recovery is a mode the user enters without a serial
@@ -762,8 +872,9 @@ static void httpd_parse(u32 rx_bytes)
 	while (*p == ' ' || *p == '\t')
 		p++;
 	clen = simple_strtoul(p, NULL, 10);
-	if (!clen || clen > UPLOAD_MAX) {
-		printf("httpd: refusing %lu byte upload\n", clen);
+	if (!clen || clen > upload_max()) {
+		printf("httpd: refusing %lu byte upload (max %lu)\n",
+		       clen, upload_max());
 		up_failed = 1;
 		return;
 	}
@@ -1100,6 +1211,71 @@ static int run_step(const char *var, const char *builtin)
 	return run_command(builtin, 0);
 }
 
+/*
+ * The <select> arrives as an ordinary multipart field, so its value is a run
+ * of bytes in the upload buffer rather than a C string -- compare by length.
+ */
+static const struct stock_vol *vol_find(const struct up_part *sel)
+{
+	int i;
+
+	if (!sel)
+		return NULL;
+
+	for (i = 0; i < ARRAY_SIZE(stock_vols); i++) {
+		size_t len = strlen(stock_vols[i].name);
+
+		if (sel->size == len &&
+		    !memcmp((void *)sel->addr, stock_vols[i].name, len))
+			return &stock_vols[i];
+	}
+
+	return NULL;
+}
+
+/* Restore one factory volume in place; the rest of the layout is untouched. */
+static int flash_vol(ulong addr, const struct stock_vol *v)
+{
+	char cmd[80];
+
+	if (run_command(CMD_ATTACH_UBI, 0)) {
+		printf("httpd: attaching UBI FAILED\n");
+		return -1;
+	}
+
+	printf("httpd: writing %s volume, %u bytes\n", v->name, v->size);
+	snprintf(cmd, sizeof(cmd), "ubi write 0x%lx %s 0x%x",
+		 addr, v->name, v->size);
+	if (run_command(cmd, 0)) {
+		printf("httpd: writing %s FAILED\n", v->name);
+		return -1;
+	}
+
+	return 0;
+}
+
+static int flash_stock(ulong addr, u32 off, u32 size, const char *what)
+{
+	char cmd[80];
+
+	printf("httpd: erasing %s, %u bytes at 0x%x\n", what, size, off);
+	snprintf(cmd, sizeof(cmd), "mtd erase " STOCK_MTD " 0x%x 0x%x", off, size);
+	if (run_command(cmd, 0)) {
+		printf("httpd: erasing %s FAILED\n", what);
+		return -1;
+	}
+
+	printf("httpd: writing %s\n", what);
+	snprintf(cmd, sizeof(cmd), "mtd write " STOCK_MTD " 0x%lx 0x%x 0x%x",
+		 addr, off, size);
+	if (run_command(cmd, 0)) {
+		printf("httpd: writing %s FAILED\n", what);
+		return -1;
+	}
+
+	return 0;
+}
+
 static int flash_part(const char *what, struct up_part *part, const char *var,
 		      const char *builtin)
 {
@@ -1125,11 +1301,55 @@ static int httpd_flash(void)
 	struct up_part *bl2 = part_find(FIELD_BL2);
 	struct up_part *fip = part_find(FIELD_FIP);
 	struct up_part *fit = part_find(FIELD_FIT);
+	struct up_part *stock = part_find(FIELD_STOCK);
+	struct up_part *pfile = part_find(FIELD_PARTFILE);
 	int format = part_find(FIELD_FORMAT) != NULL;
 	int ret = -1;
 
 	httpd_blink_start();
 
+	/*
+	 * Going back to stock replaces the layout wholesale, so it never
+	 * shares a session with the UBI-side writes; the form keeps the two
+	 * apart and this returns either way rather than falling through.
+	 */
+	if (stock) {
+		if (stock->size != STOCK_TOTAL) {
+			printf("httpd: all_flash is %u bytes, expected %u\n",
+			       stock->size, STOCK_TOTAL);
+			goto out;
+		}
+
+		if (flash_stock(part_align(stock), 0, STOCK_TOTAL,
+				"factory image"))
+			goto out;
+
+		ret = 0;
+		goto out;
+	}
+
+	if (pfile) {
+		const struct stock_vol *v;
+
+		v = vol_find(part_find(FIELD_PARTNAME));
+		if (!v) {
+			printf("httpd: no such factory volume\n");
+			goto out;
+		}
+
+		if (pfile->size != v->size) {
+			printf("httpd: %s is %u bytes, expected %u\n",
+			       v->name, pfile->size, v->size);
+			goto out;
+		}
+
+		if (flash_vol(part_align(pfile), v))
+			goto out;
+
+		ret = 0;
+		goto out;
+	}
+
 	if (bl2 && flash_part("BL2", bl2, ENV_WRITE_BL2, DEF_WRITE_BL2))
 		goto out;
 
