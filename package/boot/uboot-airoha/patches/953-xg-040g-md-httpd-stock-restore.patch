+/* Going back to stock.  Mutually exclusive with the three fields above. */
+#define FIELD_STOCK		"stock"		/* whole-chip all_flash.bin */
+#define FIELD_PARTFILE		"partfile"	/* one factory partition */
+#define FIELD_PARTNAME		"partname"	/* which one it is */
+
+/*
+ * Per-unit factory data that the ubi layout keeps as UBI volumes.
+ *
+ * These are NOT the stock mtd partitions of the same name.  Stock keeps ri at
+ * a fixed offset of 0x5200000, which on this layout is 80 MiB deep inside the
+ * ubi partition (0x20000..0x10000000) -- writing raw bytes there would tear
+ * through UBI's erase-counter and volume-id headers and destroy the whole
+ * volume table, and it would not even work: ethaddr_factory does "ubi read
+ * ... ri", so it reads the volume, never the offset.
+ *
+ * Same contents and same length as the stock partition (the MAC still sits at
+ * +0x3e), different container.  So this restores them as volumes.
+ */
+struct stock_vol {
+	const char	*name;
+	u32		size;
+};
+
+static const struct stock_vol stock_vols[] = {
+	{ "ri",		0x40000 },	/* factory MAC at +0x3e */
+	{ "bosa",	0x40000 },	/* optics calibration */
+};
+
+/* all_flash: everything the factory map covers, 235.625 MiB. */
+#define STOCK_TOTAL		0xeba0000
+
+/*
+ * Whole-chip restore goes to the raw device rather than one of our
+ * partitions: bl2 ends at 0x20000 and ubi begins there, so neither can reach
+ * offset 0 with a factory-sized write.  It is only safe because going back to
+ * stock discards this layout wholesale -- UBI is meant to be gone afterwards.
+ */
+#define STOCK_MTD		"spi-nand0"
+
