+		  SZ_2K, SZ_256, SZ_128K, 0, 5, 128,
+		  NAND_ECC_INFO(4, SZ_512), 0 },
+	{"S34ML01G1 1G 3.3V 8-bit",
+		{ .id = {0x01, 0xf1, 0x00, 0x1d} },
+		  SZ_2K, SZ_128, SZ_128K, 0, 4, 64,
+		  NAND_ECC_INFO(1, SZ_512), 0 },
+	{"S34ML02G1 2G 3.3V 8-bit",
+		{ .id = {0x01, 0xda, 0x90, 0x95, 0x44} },
+		  SZ_2K, SZ_256, SZ_128K, 0, 5, 64,
+		  NAND_ECC_INFO(1, SZ_512), 0 },
+	{"S34ML04G1 4G 3.3V 8-bit",
+		{ .id = {0x01, 0xdc, 0x90, 0x95, 0x54} },
+		  SZ_2K, SZ_512, SZ_128K, 0, 5, 64,
+		  NAND_ECC_INFO(1, SZ_512), 0 },
+	{"S34ML02G2 2G 3.3V 8-bit",
+		{ .id = {0x01, 0xda, 0x90, 0x95, 0x46} },
+		  SZ_2K, SZ_256, SZ_128K, 0, 5, 128,
+		  NAND_ECC_INFO(4, SZ_512), 0 },
+	{"S34ML02G2 2G 3.3V 8-bit (alt ID order)",
+		{ .id = {0x01, 0xda, 0x46, 0x95, 0x90} },
+		  SZ_2K, SZ_256, SZ_128K, 0, 5, 128,
+		  NAND_ECC_INFO(4, SZ_512), 0 },
 	{"TC58NVG2S0F 4G 3.3V 8-bit",
 		{ .id = {0x98, 0xdc, 0x90, 0x26, 0x76, 0x15, 0x01, 0x08} },
 		  SZ_4K, SZ_512, SZ_256K, 0, 8, 224, NAND_ECC_INFO(4, SZ_512) },
