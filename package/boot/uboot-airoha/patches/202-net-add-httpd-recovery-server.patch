+/*
+ * Panel feedback.  Recovery is a mode the user enters without a serial
+ * console, so the front LEDs are the only way to tell them the board is
+ * waiting for an upload rather than dead.  Labels that do not exist on a
+ * board are skipped.
+ */
+#if CONFIG_IS_ENABLED(LED)
+static const char * const led_chase[] = {
+	"green:power", "green:wan", "green:wan-online",
+	"green:usb-1", "green:usb-2",
+};
+
+#define LED_TICK_MS	120
+#define LED_BLINK_US	250000
+
+static int led_pos;
+static int led_blink_on;
+static struct udevice *led_dev[ARRAY_SIZE(led_chase)];
+static struct cyclic_info led_cyclic;
+
+/* Looking devices up by label once keeps the cyclic callback cheap. */
+static void led_probe(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(led_chase); i++)
+		if (led_get_by_label(led_chase[i], &led_dev[i]))
+			led_dev[i] = NULL;
+}
+
+static void led_one(unsigned int i, enum led_state_t state)
+{
+	if (led_dev[i])
+		led_set_state(led_dev[i], state);
+}
+
+static void led_all(enum led_state_t state)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(led_chase); i++)
+		led_one(i, state);
+}
+
+/* Re-arms itself: net_loop() clears the handler before calling it. */
+static void httpd_led_tick(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(led_chase); i++)
+		led_one(i, i == (unsigned int)led_pos ? LEDST_ON : LEDST_OFF);
+
+	led_pos = (led_pos + 1) % ARRAY_SIZE(led_chase);
+	net_set_timeout_handler(LED_TICK_MS, httpd_led_tick);
+}
+
+static void httpd_led_start(void)
+{
+	led_probe();
+	led_pos = 0;
+	httpd_led_tick();
+}
+
+static void httpd_led_stop(void)
+{
+	net_set_timeout_handler(0, NULL);
+	led_all(LEDST_OFF);
+}
+
+/*
+ * Flashing is synchronous, so net_loop()'s timeout handler is no longer
+ * running and the chase above cannot drive the panel.  The SPI-NAND layer
+ * calls schedule() once per written page, and that is what ticks the cyclic
+ * framework -- so this keeps blinking even in the middle of a 235 MB write.
+ */
+static void httpd_blink(struct cyclic_info *c)
+{
+	(void)c;
+
+	led_blink_on = !led_blink_on;
+	led_all(led_blink_on ? LEDST_ON : LEDST_OFF);
+}
+
+static void httpd_blink_start(void)
+{
+	led_blink_on = 0;
+	cyclic_register(&led_cyclic, httpd_blink, LED_BLINK_US, "httpd-flash");
+}
+
+static void httpd_blink_stop(void)
+{
+	cyclic_unregister(&led_cyclic);
+	led_all(LEDST_OFF);
+}
+#else
+static inline void httpd_led_start(void) { }
+static inline void httpd_led_stop(void) { }
+static inline void httpd_blink_start(void) { }
+static inline void httpd_blink_stop(void) { }
+#endif
