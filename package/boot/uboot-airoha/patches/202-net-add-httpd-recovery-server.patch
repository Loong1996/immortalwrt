+/*
+ * ---- JSON ----------------------------------------------------------------
+ *
+ * The three GET endpoints build their reply in a static buffer each; this
+ * is the little writer they share.  Overflow is not an error at write time:
+ * the buffer is simply cut and the fact reported once at the end.
+ */
+struct jbuf {
+	char	*b;
+	int	max;
+	int	n;
+};
+
+static void jb_init(struct jbuf *j, char *b, int max)
+{
+	j->b = b;
+	j->max = max;
+	j->n = 0;
+	b[0] = '\0';
+}
+
+static void jb_printf(struct jbuf *j, const char *fmt, ...)
+{
+	va_list ap;
+
+	if (j->n >= j->max)
+		return;
+	va_start(ap, fmt);
+	j->n += vsnprintf(j->b + j->n, j->max - j->n, fmt, ap);
+	va_end(ap);
+}
+
+/* A JSON string: quotes and backslashes escaped, control bytes blanked. */
+static void jb_str(struct jbuf *j, const char *s)
+{
+	char *b = j->b;
+	int n = j->n, max = j->max;
+
+	if (max - n < 3) {
+		j->n = max;
+		return;
+	}
+	b[n++] = '"';
+	for (; *s && n < max - 3; s++) {
+		if (*s == '"' || *s == '\\')
+			b[n++] = '\\';
+		b[n++] = ((unsigned char)*s < 0x20) ? ' ' : *s;
+	}
+	b[n++] = '"';
+	b[n] = '\0';
+	j->n = n;
+}
+
+static int jb_done(struct jbuf *j, const char *what)
+{
+	if (j->n >= j->max) {
+		printf("httpd: %s truncated at %d bytes\n", what, j->n);
+		j->n = j->max - 1;
+	}
+
+	return j->n;
+}
+
+#define JSON_HDR(status)						\
+	"HTTP/1.0 " status "\r\n"					\
+	"Content-Type: application/json; charset=utf-8\r\n"		\
+	"Connection: close\r\n"						\
+	"\r\n"
+
+/* A volume by name on an attached device, or NULL. */
+static struct ubi_volume *ubi_vol_find(struct ubi_device *ubi, const char *name)
+{
+	int i;
+
+	for (i = 0; i < ubi->vtbl_slots; i++)
+		if (ubi->volumes[i] && !strcmp(ubi->volumes[i]->name, name))
+			return ubi->volumes[i];
+
+	return NULL;
+}
