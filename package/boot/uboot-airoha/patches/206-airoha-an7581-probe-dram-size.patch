From: Loong <1031313955@qq.com>
Subject: [PATCH] arm: airoha: an7581: probe the real DRAM size

dram_init() took the size straight from the device tree, so U-Boot reported
whatever the dts happened to say -- and then fdt_fixup_memory_banks() pushed
that same number into the kernel's dtb, overwriting the /memory node the
kernel would otherwise have used.  A board fitted with a 1 GiB part but
carrying the conservative 512 MiB dts ran with half its memory unreachable,
and no dts edit downstream could fix it, because the fixup always won.

Nothing in the boot chain reports the real size: BL2 brings up the
controller and moves on.  So probe it by address aliasing -- on a part
smaller than the address being written, the write wraps around and lands
back on a low anchor word.

The anchor sits above the ATF reservation at the bottom of DRAM, and both
words are restored before returning, so this runs safely before relocation.
The dts value stays as the base address source and as documentation of the
smallest part the board ships with.

Verified against mmap-aliased memory for the 512 MiB, 1 GiB and 2 GiB cases.

--- a/arch/arm/mach-airoha/an7581/init.c
+++ b/arch/arm/mach-airoha/an7581/init.c
+++ dr_b/arch/arm/mach-airoha/an7581/init.c	2026-08-30 12:09:53
@@ -16,9 +16,57 @@
 	return 0;
 }
 
+/*
+ * The device tree carries a conservative size, because one image ships to
+ * boards fitted with different parts and nothing in the boot chain reports
+ * the real one -- BL2 configures the controller and moves on.  Find it by
+ * address aliasing instead: on a part smaller than the address being probed,
+ * a write high up wraps around and lands back on the low anchor.
+ *
+ * The anchor sits above the ATF reservation at the bottom of DRAM, and both
+ * words are put back before returning, so this is safe to run this early.
+ */
+static ulong an7581_probe_ram_size(ulong base)
+{
+	volatile u32 *lo = (volatile u32 *)(base + SZ_2M);
+	u32 save_lo = *lo;
+	ulong size;
+
+	for (size = SZ_512M; size < SZ_2G; size <<= 1) {
+		volatile u32 *hi = (volatile u32 *)((ulong)lo + size);
+		u32 save_hi = *hi;
+
+		*lo = 0x5a5aa5a5;
+		*hi = 0xa5a55a5a;
+		__asm__ __volatile__("dsb sy" : : : "memory");
+
+		if (*lo != 0x5a5aa5a5) {
+			/* Wrapped, so *hi and *lo are the same word. */
+			*hi = save_hi;
+			*lo = save_lo;
+
+			return size;
+		}
+
+		*hi = save_hi;
+	}
+
+	*lo = save_lo;
+
+	return SZ_2G;
+}
+
 int dram_init(void)
 {
-	return fdtdec_setup_mem_size_base();
+	int ret;
+
+	ret = fdtdec_setup_mem_size_base();
+	if (ret)
+		return ret;
+
+	gd->ram_size = an7581_probe_ram_size(gd->ram_base);
+
+	return 0;
 }
 
 int dram_init_banksize(void)
